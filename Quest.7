#include <stdio.h>

int main () {
    int valores[]= {1, 2, 3, 4, 5, 6};
    int *inicio= valores;
    int *fim= valores + 5;
    
    while (inicio<fim) {
        int temp= *inicio;
        *inicio= *fim;
        *fim= temp;
        inicio++;
        fim--;
    }
    for (int i=0; i<6; i++) {
        printf("%d", valores[i]);
    }
    printf("\n");
    
    return 0;
}
