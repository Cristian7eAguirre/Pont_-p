#include <stdio.h>

int *encontrarMaior(int *inicio, int tamanho) {
    int *maior = inicio;
    for(int i=1; i<tamanho; i++){
        if(*(inicio + i) > *maior){
            maior = inicio + i;
        }
    }
    return maior;
}

int main () {
    int numeros[5];
    printf("Digite 5 numeros inteiros:\n");
    for(int i=0; i<5; i++) {
        scanf("%d", &numeros[i]);
    }
    int *endMaior = encontrarMaior(numeros, 5);
    int posicao = endMaior - numeros;
    
    printf("Maior valor: %d\n", *endMaior);
    printf("Posicao no vetor: %d\n", posicao);
    printf("Endereco de memoria: %p\n", endMaior);
    
    return 0;
}
